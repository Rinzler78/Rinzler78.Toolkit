<Project Sdk="Microsoft.NET.Sdk">

  <!-- A props/targets package. It produces no assembly: the payload is the two
       MSBuild files under build/, auto-imported on restore through
       {project}.nuget.g.props, so the same semantics apply under F5 in an IDE and
       in continuous integration. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsPackable>true</IsPackable>
    <RinzlerLayer>Toolchain</RinzlerLayer>
    <PackageId>Rinzler78.Build</PackageId>
    <Description>Shared build semantics: analysers, warnings as errors, deterministic build, SourceLink, symbols, documentation, and declarative contracts for trimming, coverage and architecture. Domain-agnostic: the mechanisms live here, the policy is declared by the consuming repository.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/Rinzler78.Build.props" Pack="true" PackagePath="build/" />
    <None Include="build/Rinzler78.Build.targets" Pack="true" PackagePath="build/" />
    <None Include="build/Rinzler78.Build.props" Pack="true" PackagePath="buildMultiTargeting/" />
    <None Include="build/Rinzler78.Build.targets" Pack="true" PackagePath="buildMultiTargeting/" />
    <!-- The same two files, also reachable as an MSBuild project SDK. A consumer
         that declares this package in global.json's msbuild-sdks gets the semantics
         *before* evaluation, which is the only way a project can read a named
         target-framework set from here. -->
    <None Include="Sdk/Sdk.props" Pack="true" PackagePath="Sdk/" />
    <None Include="Sdk/Sdk.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
