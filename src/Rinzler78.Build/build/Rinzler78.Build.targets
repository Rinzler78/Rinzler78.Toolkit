<Project>

  <!-- Imported after the consuming project, so these rules see its final values
       and can refuse a combination the project set. -->

  <!-- A symbol package needs an assembly to carry symbols for. A project shipping no
       build output — a props/targets package, a template pack — produces an empty
       .snupkg, and pack fails with NU5017 *while still emitting the main package*, so
       the failure reads like noise and gets ignored.

       This lives in the targets because it depends on IncludeBuildOutput, which the
       consuming project sets after the props are imported: the same evaluation-order
       trap that already cost two rules. -->
  <PropertyGroup>
    <IncludeSymbols Condition="'$(IncludeBuildOutput)' != 'false'">true</IncludeSymbols>
    <IncludeSymbols Condition="'$(IncludeBuildOutput)' == 'false'">false</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(IncludeSymbols)' == 'true'">snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Trimming and ahead-of-time compatibility require net6.0 or later. Declaring
       them on netstandard2.0 produces a project that cannot build, so the contract
       is applied through a framework test rather than a string comparison, and the
       slices of a multi-targeted project that predate trimming are out of scope
       whatever the declared value.

       Committed — the library shrinks in every integrator's Release build, so it is
       marked trimmable and held to AOT compatibility. The AOT marking starts at
       net7.0, where its analysers exist: on net6.0 it switches the trim checks off,
       which would make a Committed library look enforced while it is not.
       Analyzed  — the trim analyser runs and flags what would break, but nothing is
       marked trimmable: IsTrimmable is a promise, and this value makes none.
       OutOfScope — not a trimming subject: nothing is set. -->
  <PropertyGroup Condition="'$(RinzlerTrimContract)' == 'Committed' AND
                            $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RinzlerTrimContract)' == 'Committed' AND
                            $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RinzlerTrimContract)' == 'Analyzed' AND
                            $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- Debug serves diagnosis and is left to the SDK defaults, except that a Xamarin.Android
       debug build deploys assemblies only. The property was removed from .NET for Android
       in .NET 9, where fast deployment is the default of a Debug build.

       Release enables what the project can enable, each property under the name its
       platform gives it. The cheap ones (R8, ReadyToRun, compression) are unconditional;
       the costly ones follow RinzlerCostlyOptimisations. A value the project set is
       kept. The identifiers are derived from TargetFramework, because the SDK has not
       derived its own yet when this file is imported, and a Xamarin moniker carries no
       platform part. -->
  <PropertyGroup>
    <_RinzlerFrameworkIdentifier>$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)'))</_RinzlerFrameworkIdentifier>
    <_RinzlerPlatformIdentifier>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_RinzlerPlatformIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_RinzlerFrameworkIdentifier)' == 'MonoAndroid' AND '$(Configuration)' == 'Debug'">
    <AndroidFastDeploymentType Condition="'$(AndroidFastDeploymentType)' == ''">Assemblies</AndroidFastDeploymentType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <_RinzlerCostly>true</_RinzlerCostly>
    <_RinzlerCostly Condition="'$(RinzlerCostlyOptimisations)' == 'false'">false</_RinzlerCostly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND
                            (('$(_RinzlerFrameworkIdentifier)' == '.NETCoreApp' AND '$(_RinzlerPlatformIdentifier)' == 'Android') OR
                             '$(_RinzlerFrameworkIdentifier)' == 'MonoAndroid')">
    <AndroidLinkTool Condition="'$(AndroidLinkTool)' == ''">r8</AndroidLinkTool>
    <AndroidEnableProfiledAot Condition="'$(AndroidEnableProfiledAot)' == ''">$(_RinzlerCostly)</AndroidEnableProfiledAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(_RinzlerFrameworkIdentifier)' == '.NETCoreApp' AND '$(_RinzlerPlatformIdentifier)' == 'Android'">
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">$(_RinzlerCostly)</RunAOTCompilation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(_RinzlerFrameworkIdentifier)' == 'MonoAndroid'">
    <AotAssemblies Condition="'$(AotAssemblies)' == ''">$(_RinzlerCostly)</AotAssemblies>
    <EnableLLVM Condition="'$(EnableLLVM)' == ''">$(_RinzlerCostly)</EnableLLVM>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND
                            (('$(_RinzlerFrameworkIdentifier)' == '.NETCoreApp' AND '$(_RinzlerPlatformIdentifier)' == 'iOS') OR
                             '$(_RinzlerFrameworkIdentifier)' == 'Xamarin.iOS')">
    <MtouchUseLlvm Condition="'$(MtouchUseLlvm)' == ''">$(_RinzlerCostly)</MtouchUseLlvm>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">$(_RinzlerCostly)</RunAOTCompilation>
    <BlazorEnableCompression Condition="'$(BlazorEnableCompression)' == ''">true</BlazorEnableCompression>
  </PropertyGroup>

  <!-- ReadyToRun needs a runtime identifier: without one the property has nothing to
       compile for. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(UsingMicrosoftNETSdkWeb)' == 'true' AND '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
  </PropertyGroup>

  <Target Name="RinzlerValidateContracts" BeforeTargets="Build">
    <Error Condition="'$(RinzlerTrimContract)' != 'Committed' AND
                      '$(RinzlerTrimContract)' != 'Analyzed' AND
                      '$(RinzlerTrimContract)' != 'OutOfScope'"
           Text="RinzlerTrimContract must be Committed, Analyzed or OutOfScope; found '$(RinzlerTrimContract)'." />
    <Error Condition="'$(RinzlerCoverageContract)' != 'Enforced' AND
                      '$(RinzlerCoverageContract)' != 'Reduced' AND
                      '$(RinzlerCoverageContract)' != 'Exempt'"
           Text="RinzlerCoverageContract must be Enforced, Reduced or Exempt; found '$(RinzlerCoverageContract)'." />
  </Target>

  <!-- MSBuild evaluates file-level properties before items, so a property reading
       @(PackageReference) at that scope is always empty. IsPackable is set by the
       SDK targets, imported after this file, so a rule conditioned on it at file
       scope silently never fires. Both facts are therefore resolved inside a
       target, where they exist. -->
  <Target Name="RinzlerCollectFacts">
    <PropertyGroup>
      <_RinzlerAnalysers>;@(PackageReference->'%(Identity)');@(GlobalPackageReference->'%(Identity)');</_RinzlerAnalysers>
      <_RinzlerForbidden>;@(RinzlerForbiddenDependency);</_RinzlerForbidden>
      <_RinzlerShipsPackage>false</_RinzlerShipsPackage>
      <_RinzlerShipsPackage Condition="'$(IsPackable)' == 'true'">true</_RinzlerShipsPackage>
    </PropertyGroup>
  </Target>

  <!-- The dependency rule, enforced rather than reviewed.

       It inspects the dependencies the project *chose* — its PackageReference
       items — not the resolved reference set. On a modern target framework the
       shared framework already carries System.Net.Http and its neighbours, so
       forbidding resolved references would fail every project for owning a base
       class library it never asked for. A dependency is something declared.

       What counts as outward is the consumer's to say: this file knows how to
       refuse, not what to refuse. -->
  <Target Name="RinzlerEnforceDependencyRule" BeforeTargets="CoreCompile"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_RinzlerForbidden)' != ';;' AND
                      $(_RinzlerForbidden.Contains(';%(PackageReference.Identity);'))"
           Text="Dependency rule: a project in layer '$(RinzlerLayer)' may not depend on '%(PackageReference.Identity)'. Source dependencies point inward only." />
  </Target>

  <!-- A layer name is only useful if it is checked: a typo would otherwise match no
       forbidden set and silently disable the rule above. Validation applies only
       when the consumer has declared a vocabulary.

       The vocabulary is split into items rather than searched as a string. A
       substring search for ';Binding;' in 'Binding;Wrapper' finds nothing, so the
       documented form refused every layer, the first and the last included; items
       also drop the whitespace of a vocabulary written one layer per line. -->
  <Target Name="RinzlerValidateLayer" BeforeTargets="Build"
          Condition="'$(RinzlerKnownLayers)' != '' AND '$(RinzlerLayer)' != 'Unassigned'">
    <ItemGroup>
      <_RinzlerKnownLayer Include="$(RinzlerKnownLayers)" />
    </ItemGroup>
    <Error Condition="'@(_RinzlerKnownLayer->AnyHaveMetadataValue('Identity', '$(RinzlerLayer)'))' != 'true'"
           Text="RinzlerLayer '$(RinzlerLayer)' is not one of @(_RinzlerKnownLayer, ', ')." />
  </Target>

  <Target Name="RinzlerRequireLayer" BeforeTargets="Build"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="'$(RinzlerKnownLayers)' != '' AND '$(_RinzlerShipsPackage)' == 'true' AND
                     '$(RinzlerLayer)' == 'Unassigned'">
    <Error Text="A packable project must declare RinzlerLayer so the dependency rule can be checked. Accepted: $(RinzlerKnownLayers)." />
  </Target>

  <!-- Analysers a project depends on are declared by the consuming repository, in
       central package management, because that is what owns versions. A
       props/targets package must not inject a PackageReference — but it can refuse
       to build when a required analyser is absent, so that the guarantee is not
       silently optional. -->
  <Target Name="RinzlerRequireAnalysers" BeforeTargets="Build"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="'@(RinzlerRequiredAnalyzer)' != ''">
    <Error Condition="!$(_RinzlerAnalysers.Contains(';%(RinzlerRequiredAnalyzer.Identity);'))"
           Text="This project must reference %(RinzlerRequiredAnalyzer.Identity): %(RinzlerRequiredAnalyzer.Because)" />
  </Target>

  <!-- A required description fragment — a non-affiliation statement, a licence
       note, an attribution — is a domain obligation, not a build one. The
       mechanism lives here; the text lives with the domain that owes it. -->
  <Target Name="RinzlerRequireDescription" BeforeTargets="GenerateNuspec"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="'$(RinzlerRequiredDescription)' != '' AND '$(_RinzlerShipsPackage)' == 'true'">
    <Error Condition="!$(Description.Contains('$(RinzlerRequiredDescription)'))"
           Text="The package description must contain: $(RinzlerRequiredDescription)" />
  </Target>

  <!-- A required README fragment — a non-affiliation statement, a licence note — is the
       README counterpart of the description fragment above: the mechanism lives here, the
       text with the domain that owes it. It binds a project that ships a package, because
       that README is what a consumer reads; a missing README fails like a README without
       the text. A fragment is one item, so it cannot contain a semicolon. A quote is legal in a
       fragment but not in the expression that searches for it, so both sides are compared
       with the quote replaced by a private-use character, which no README carries. -->
  <Target Name="RinzlerRequireReadmeFragment" BeforeTargets="Build"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="'@(RinzlerRequiredReadmeFragment)' != '' AND '$(_RinzlerShipsPackage)' == 'true'">
    <PropertyGroup>
      <_RinzlerReadmePath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RinzlerReadme)'))</_RinzlerReadmePath>
      <_RinzlerReadmeText Condition="Exists('$(_RinzlerReadmePath)')">$([System.IO.File]::ReadAllText('$(_RinzlerReadmePath)').Replace("'", ''))</_RinzlerReadmeText>
    </PropertyGroup>
    <ItemGroup>
      <_RinzlerFragment Include="@(RinzlerRequiredReadmeFragment->Replace(&quot;'&quot;, ''))" />
    </ItemGroup>
    <Error Condition="!Exists('$(_RinzlerReadmePath)')"
           Text="$(RinzlerReadme) is missing: it must contain @(RinzlerRequiredReadmeFragment, '; ')." />
    <Error Condition="Exists('$(_RinzlerReadmePath)') AND !$(_RinzlerReadmeText.Contains('%(_RinzlerFragment.Identity)'))"
           Text="$(RinzlerReadme) must contain: $([System.String]::Copy('%(_RinzlerFragment.Identity)').Replace('', &quot;'&quot;))" />
  </Target>

  <!-- No project reference crosses a repository boundary. A repository is the tree under
       the nearest Directory.Packages.props — every repository owns one, since central
       package management is mandatory — so a submodule, which owns its own, is another
       repository even though it sits inside this one's folder. A project outside any
       such tree is foreign too. Where the referencing project has no boundary marker, no
       policy is declared and nothing is checked. Paths are compared as written, so a
       reference spelled through a filesystem alias of the project folder (macOS
       /tmp for /private/tmp) is read as foreign: spell references relative. -->
  <Target Name="RinzlerRefuseForeignProjectReference" BeforeTargets="ResolveProjectReferences"
          Condition="'@(ProjectReference)' != ''">
    <PropertyGroup>
      <_RinzlerOwnBoundary>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'Directory.Packages.props'))</_RinzlerOwnBoundary>
    </PropertyGroup>
    <ItemGroup Condition="'$(_RinzlerOwnBoundary)' != ''">
      <_RinzlerReferenced Include="@(ProjectReference->'%(FullPath)')">
        <Boundary>$([MSBuild]::GetDirectoryNameOfFileAbove('%(RootDir)%(Directory)', 'Directory.Packages.props'))</Boundary>
      </_RinzlerReferenced>
    </ItemGroup>
    <Error Condition="'@(_RinzlerReferenced)' != '' AND '%(_RinzlerReferenced.Boundary)' != '$(_RinzlerOwnBoundary)'"
           Text="'$(MSBuildProjectName)' references %(_RinzlerReferenced.Identity), which belongs to another repository. Cross-repository dependencies are package references." />
  </Target>

  <!-- A suppression is a decision, and a decision carries its reason. A warning disabled by
       a pragma needs the reason on the same line, after `//`; a SuppressMessage needs a
       non-empty Justification. Either missing fails the build, naming the file and the
       rule. The first offender of each kind in a file is named. C# only. Not scanned:
       generated code under the intermediate output folder, and a file whose leading
       comment carries `<auto-generated`, the convention every generator follows, which
       is where a designer file keeps the pragma it ships with.
       The target runs when a source changed, tracked by a stamp per target framework.

       Regular expressions over the source, not a syntax walk: a pragma inside a string
       literal or a comment is read as one. That errs towards asking for a reason, which is
       the safe side of a rule that exists to make reasons exist. -->
  <Target Name="RinzlerRequireSuppressionJustification" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(Compile);$(MSBuildThisFileFullPath)"
          Outputs="$(IntermediateOutputPath)rinzler-suppressions.stamp">
    <PropertyGroup>
      <_RinzlerGenerated>(?s)\A(?:[ \t]*(?://[^\r\n]*)?\r?\n)*?[ \t]*//[^\r\n]*&lt;auto-generated</_RinzlerGenerated>
      <_RinzlerObj>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))</_RinzlerObj>
      <_RinzlerPragmaCore>^[ \t]*\#[ \t]*pragma[ \t]+warning[ \t]+disable([ \t]+[^/\r\n]*?)?[ \t]*(//[ \t]*)?\r?$</_RinzlerPragmaCore>
      <_RinzlerPragmaFind>(?m)$(_RinzlerPragmaCore)</_RinzlerPragmaFind>
      <_RinzlerPragmaRule>(?ms)\A.*?$(_RinzlerPragmaCore).*\z</_RinzlerPragmaRule>
      <_RinzlerSuppressFind>SuppressMessage(?:Attribute)?\s*\((?:(?!Justification)[^\]])*\)[ \t]*\]|Justification[ \t]*=[ \t]*"[ \t]*"</_RinzlerSuppressFind>
    </PropertyGroup>
    <ItemGroup>
      <_RinzlerCSharp Include="@(Compile)" Condition="'%(Extension)' == '.cs'" />
      <_RinzlerSource Include="@(_RinzlerCSharp)"
                      Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_RinzlerObj)'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_RinzlerSource)' != ''">
      <_RinzlerHandWritten Include="@(_RinzlerSource)"
                           Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_RinzlerGenerated)'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_RinzlerHandWritten)' != ''">
      <_RinzlerBareSuppression Include="@(_RinzlerHandWritten)"
                               Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_RinzlerSuppressFind)'))" />
      <_RinzlerBarePragma Include="@(_RinzlerHandWritten)"
                          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_RinzlerPragmaFind)'))">
        <Rule>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '$(_RinzlerPragmaRule)', '$1').Trim())</Rule>
      </_RinzlerBarePragma>
    </ItemGroup>
    <Error Condition="'@(_RinzlerBarePragma)' != ''"
           Text="%(_RinzlerBarePragma.Identity): '#pragma warning disable %(_RinzlerBarePragma.Rule)' has no justification. Write the reason after // on the same line, with the ADR or issue tracking its removal." />
    <Error Condition="'@(_RinzlerBareSuppression)' != ''"
           Text="%(_RinzlerBareSuppression.Identity): a SuppressMessage has no justification. Give it a non-empty Justification naming the root cause and the ADR or issue tracking its removal." />
    <Touch Files="$(IntermediateOutputPath)rinzler-suppressions.stamp" AlwaysCreate="true" />
  </Target>

  <!-- A coverage contract below Enforced is a decision, and a decision has a record: the
       project names the ADR that argues it. A project shipping no package — a test
       project, a trimming application, a demonstration — has no surface to cover and
       owes none. -->
  <Target Name="RinzlerRequireCoverageAdr" BeforeTargets="Build"
          DependsOnTargets="RinzlerCollectFacts"
          Condition="('$(RinzlerCoverageContract)' == 'Reduced' OR '$(RinzlerCoverageContract)' == 'Exempt') AND
                     '$(_RinzlerShipsPackage)' == 'true' AND '$(IsTestProject)' != 'true'">
    <PropertyGroup>
      <_RinzlerAdrPath Condition="'$(RinzlerCoverageAdr)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RinzlerCoverageAdr)'))</_RinzlerAdrPath>
    </PropertyGroup>
    <Error Condition="'$(RinzlerCoverageAdr)' == ''"
           Text="RinzlerCoverageContract $(RinzlerCoverageContract) requires RinzlerCoverageAdr: the ADR file that argues it." />
    <Error Condition="'$(RinzlerCoverageAdr)' != '' AND !Exists('$(_RinzlerAdrPath)')"
           Text="RinzlerCoverageAdr names $(RinzlerCoverageAdr), which does not exist." />
  </Target>

  <!-- Two rules about a published surface, stopping where there is none.

       CS1591 asks for documentation: xUnit requires a test class to be public, and
       the rule then demands prose about a fixture that has no consumer.

       CA1707 forbids underscores in a member name: a test name is a sentence read by
       a human in a failure report — `Name_is_the_simple_name_of_the_assembly` — not
       an identifier anyone calls. Renaming it to satisfy a naming convention written
       for public API is the check driving the code, which is the wrong way round.

       Neither can be a condition in the props: IsTestProject is set by the project,
       which is evaluated after an imported props file, so the condition would never
       fire. Third time this order has cost a rule — it is written down at each site
       it bit. -->
  <Target Name="RinzlerRelaxSurfaceRulesForTests" BeforeTargets="CoreCompile"
          Condition="'$(IsTestProject)' == 'true'">
    <PropertyGroup>
      <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
      <WarningsAsErrors>$(WarningsAsErrors.Replace('CS1591', '').Replace('CA1707', ''))</WarningsAsErrors>
    </PropertyGroup>
  </Target>

</Project>
