<Project>

  <!-- Imported before the consuming project's own properties, so everything here
       can be overridden by the project that imports it. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Documentation is part of the public surface: an undocumented public member
       is an error, not a warning. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Reproducibility. ContinuousIntegrationBuild is set by the workflow, never
       here, so that a local build stays debuggable. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Which of the eight layers this project sits in. The dependency rule is
       checked against it after compilation. `Unassigned` is refused for a packable
       project: a package with no layer cannot be checked. -->
  <PropertyGroup>
    <HereLayer Condition="'$(HereLayer)' == ''">Unassigned</HereLayer>
    <HereKnownLayers>;Binding;Wrapper;Contracts;PortableServices;Presentation;StandardisationAdapter;Facade;CrossPlatformHead;Toolchain;Sample;Test;</HereKnownLayers>
  </PropertyGroup>

  <!-- Target framework sets, named once so that eighteen repositories cannot
       disagree about what "portable" means. -->
  <PropertyGroup>
    <HerePortableTargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</HerePortableTargetFrameworks>
    <HereModernTargetFrameworks>net8.0;net9.0;net10.0</HereModernTargetFrameworks>
    <HereAppleTargetFrameworks>net8.0-ios;net9.0-ios;net10.0-ios</HereAppleTargetFrameworks>
    <HereAndroidTargetFrameworks>net8.0-android;net9.0-android;net10.0-android</HereAndroidTargetFrameworks>
    <HereXamarinTargetFrameworks>monoandroid12.0;xamarinios10</HereXamarinTargetFrameworks>
  </PropertyGroup>

  <!-- Reproducibility is a property of the build machine, not of the source, so
       ContinuousIntegrationBuild follows the environment rather than being pinned
       here: a local build stays debuggable. -->
  <PropertyGroup Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Per-project contracts. Every project declares its own; the values here are
       the defaults for a project that declares nothing. -->
  <PropertyGroup>
    <HereTrimContract Condition="'$(HereTrimContract)' == ''">OutOfScope</HereTrimContract>
    <HereCoverageContract Condition="'$(HereCoverageContract)' == ''">Enforced</HereCoverageContract>
  </PropertyGroup>

</Project>
