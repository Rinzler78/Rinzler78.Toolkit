<Project>

  <!-- The layer this repository sits in. The vocabulary is declared by the domain
       policy package, not here: this file states a fact about the repository, and
       the mechanism that validates it lives in Rinzler78.Build. -->
  <PropertyGroup>
    <RinzlerLayer>Unassigned</RinzlerLayer>
  </PropertyGroup>

  <!-- Release tags are vMAJOR.MINOR.PATCH: scripts/_release-tag.sh refuses any other
       form, and MinVer must read the same one. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

</Project>
