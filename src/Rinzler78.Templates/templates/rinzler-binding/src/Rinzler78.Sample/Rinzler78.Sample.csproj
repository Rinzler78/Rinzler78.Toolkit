<Project Sdk="Microsoft.NET.Sdk">

  <!-- Resolved before evaluation, version pinned in global.json. -->
  <Sdk Name="Rinzler78.Build" />

  <PropertyGroup>
    <!-- A projection carries a native dependency, so it cannot promise the
         netstandard surface a portable library promises. -->
    <TargetFrameworks>$(RinzlerModernTargetFrameworks)</TargetFrameworks>
    <PackageId>Rinzler78.Sample</PackageId>
    <Description>Say which native library this projects, and at which version. A package with no description does not pack.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged README is the repository's own, so the page on nuget.org cannot
         drift from the page on GitHub. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
