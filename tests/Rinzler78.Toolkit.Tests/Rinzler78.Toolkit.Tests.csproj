<Project Sdk="Microsoft.NET.Sdk">

  <!-- The harness scripts every generated repository runs. They are tested here, in
       the repository that owns them, against throwaway git repositories: a script
       that decides whether a tag may publish is not verified by reading it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RinzlerCoverageContract>Exempt</RinzlerCoverageContract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
