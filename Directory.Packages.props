<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Versions live here, never in a specification. -->
  </ItemGroup>
  <ItemGroup Label="Build tasks">
    <!-- The oldest MSBuild a consumer of the package may run on: a task compiled against it
         runs on every later one. -->
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
  <ItemGroup Label="Versioning">
    <!-- The version comes from the tags and from nothing else: a tagged commit builds
         the tag's version, and any other builds a prerelease counted from the last tag. Global,
         because every packable project must agree with the tag the release checks. -->
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
